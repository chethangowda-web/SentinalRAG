# ─── SentinelRAG Configuration ─────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ─── Backend ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinelrag
QDRANT_URL=http://localhost:6333
# Required: 32+ random characters (signs login tokens). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Comma-separated emails allowed to view global metrics and change settings
ADMIN_EMAILS=
# Optional: require an invite code to create an account (open sign-up if empty)
REGISTRATION_CODE=
# Index documents in the background after upload (one at a time), and optionally evaluate them (spends LLM calls)
AUTO_INDEX_ON_UPLOAD=true
AUTO_EVALUATE_ON_UPLOAD=false
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
MAX_FILE_SIZE=52428800
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
QDRANT_COLLECTION=documents

# ─── LLM ───────────────────────────────────────────────
# Gemini is used when GEMINI_API_KEY is set; otherwise Featherless, then DeepSeek.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Used in order once GEMINI_MODEL has used up its daily quota
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# Optional: e.g. "none" to stop Gemini spending output tokens on hidden thinking (not every model accepts it)
# LLM_REASONING_EFFORT=
# DeepSeek (optional fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
MAX_RETRIES=2

# ─── Railway ──────────────────────────────────────────
# RAILWAY_DATABASE_URL=postgresql+asyncpg://... (set by Railway PostgreSQL plugin)
# PORT=8080 (set automatically by Railway)

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# Answers questions unrelated to your documents without an LLM call (cross-encoder score below this).
# OFF_TOPIC_RERANK_THRESHOLD=-10.0
# Optional error tracking (Sentry DSN); leave empty to disable.
# SENTRY_DSN=
